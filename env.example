# Database Configuration
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS="your_db_password"
# Set DB_DRIVER=sqlite and DB_SQLITE_PATH=database/dev.sqlite for local preview tests.
DB_SQLITE_PATH=database/dev.sqlite

# App & CORS
APP_URL=https://your-domain.com
ALLOWED_ORIGIN=https://your-domain.com

# External AI APIs
UPSTAGE_API_KEY="your_upstage_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# Google Integration (OAuth, Drive, Sheets)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_API_KEY="your_google_api_key"
GOOGLE_REDIRECT_URI="https://your-domain.com/google_callback.php"
GOOGLE_WEBAPP_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_MASTER_SHEET_ID="your_master_sheet_id"
